# আন-নূর (Annoor) — Docker / Coolify environment
#
# ব্যবহার: এই ফাইলের একটা কপি .env নামে বানিয়ে ভ্যালু বসান (docker compose উপরে পড়ে নেয়)।
# Coolify-তে ব্যবহার করলে .env ফাইল লাগবে না — Coolify-র Environment-এ নিচের
# ভ্যারিয়েবলগুলো এক এক করে যোগ করুন (docs/DEPLOY.md দেখুন)।
#
# ⚠ পাসওয়ার্ডে স্পেস, @, :, /, # ব্যবহার করবেন না — ইংরেজি অক্ষর+সংখ্যা+! % * - _ . ঠিক আছে।

# ---- PostgreSQL (প্রথম ডিপ্লয়ের আগেই ঠিক করে নিন — পরে বদলালে ভলিউম
#      রিসেট করতে হয়, docs/DEPLOY.md-র সতর্কতা দেখুন) ----
POSTGRES_USER=annoor
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=annoora

# ---- অ্যাডমিন অ্যাকাউন্ট (প্রথম বুটে এই তথ্যে admin তৈরি হবে) ----
ADMIN_EMAIL=your@email.com
ADMIN_PASSWORD=a-strong-admin-password

# ---- অ্যাডমিন সেশন সাইনিং সিক্রেট ----
# বানানোর কমান্ড (আপনার কম্পিউটারে চালান):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=change-me-to-a-long-random-string

# ---- সাইটের পাবলিক URL (domain যোগ করার পরে বদলে দিন) ----
NEXT_PUBLIC_SITE_URL=https://annoor.xyz

# ---- অ্যাপ পোর্ট (Coolify নিজে ম্যানেজ করে — বদলাতে হবে না) ----
APP_PORT=3000
